# OpenRouter (Structured synthesis and LLM extraction)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o

# LinkedIn collection (HarvestAPI)
HARVEST_API_KEY=your_harvest_api_key_here

# Twitter/X collection (TwitterAPI.io)
TWITTER_API_KEY=your_twitter_api_key_here

# Instagram collection (Apify)
APIFY_API_KEY=your_apify_api_key_here

# AssemblyAI (all audio/video transcription)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Google Gemini (optional image OCR fallback; never audio transcription)
GEMINI_API_KEY=your_gemini_api_key_here
