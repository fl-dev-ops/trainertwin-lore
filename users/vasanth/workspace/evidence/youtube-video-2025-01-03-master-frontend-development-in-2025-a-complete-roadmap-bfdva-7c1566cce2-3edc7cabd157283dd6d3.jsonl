{"author": "careerwithvasanth", "category": "youtube", "content": {"constraints": [], "context_unit_ids": ["youtube-video-2025-01-03-master-frontend-development-in-2025-a-complete-roadmap-bfdva-7c1566cce2:u000021"], "exceptions": [], "goal": null, "kind": "offering", "prerequisites": [], "steps": [], "summary": {"citations": [{"quote": "But my all-time favorite is Code Evolution by Vishwas. So this is no paid promotion. He's one of my favorite YouTuber. I learned lot of React concepts by Vishwas.", "unit_id": "youtube-video-2025-01-03-master-frontend-development-in-2025-a-complete-roadmap-bfdva-7c1566cce2:u000021"}], "text": "Vasanth recommends learning React from Code Evolution by Vishwas, which he cites as a favorite resource for understanding React concepts."}, "title": "React learning resources", "topic": "React"}, "content_hash": "e344b73fd2438299416e511aea0e33438e76b5379be90b1d5138b5cd765259b1", "external_status": "not_checked", "extraction_scope": "source_excerpt", "id": "youtube-video-2025-01-03-master-frontend-development-in-2025-a-complete-roadmap-bfdva-7c1566cce2:knowledge:635db464f5eb6acc", "metadata_hash": "80de6a9fc71e04e70294db03ae496a0c4864721574ccf735d1fd93f4c265ca67", "product": "knowledge", "published_at": "2025-01-03", "semantic_status": "not_reviewed", "source_format": "transcript", "source_hash": "7eed79355bd51b176dbede9688b1d5f665aa031f69e7ed469a3b51f70d9d2114", "source_id": "youtube-video-2025-01-03-master-frontend-development-in-2025-a-complete-roadmap-bfdva-7c1566cce2", "source_url": "https://www.youtube.com/watch?v=BfDVA_OsFLM", "title": "React learning resources", "topic": "React", "topic_slug": "react"}
