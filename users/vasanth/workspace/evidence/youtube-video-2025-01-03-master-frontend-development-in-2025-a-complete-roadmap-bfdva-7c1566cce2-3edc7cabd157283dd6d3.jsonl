{"author": "careerwithvasanth", "category": "youtube", "content": {"constraints": [], "context_unit_ids": ["youtube-video-2025-01-03-master-frontend-development-in-2025-a-complete-roadmap-bfdva-7c1566cce2:u000020"], "exceptions": [], "goal": null, "kind": "advice", "prerequisites": [], "steps": [], "summary": {"citations": [{"quote": "take as many mock interviews as possible there are tons of websites where you can learn mock interviews for free okay so go through those websites", "unit_id": "youtube-video-2025-01-03-master-frontend-development-in-2025-a-complete-roadmap-bfdva-7c1566cce2:u000020"}], "text": "Vasanth suggests engaging in as many mock interviews as possible for practice, through online platforms or community arrangements."}, "title": "Participating in mock interviews", "topic": "Interview preparation"}, "content_hash": "e344b73fd2438299416e511aea0e33438e76b5379be90b1d5138b5cd765259b1", "external_status": "not_checked", "extraction_scope": "source_excerpt", "id": "youtube-video-2025-01-03-master-frontend-development-in-2025-a-complete-roadmap-bfdva-7c1566cce2:knowledge:0d864b0c85eb6596", "metadata_hash": "80de6a9fc71e04e70294db03ae496a0c4864721574ccf735d1fd93f4c265ca67", "product": "knowledge", "published_at": "2025-01-03", "semantic_status": "not_reviewed", "source_format": "transcript", "source_hash": "7eed79355bd51b176dbede9688b1d5f665aa031f69e7ed469a3b51f70d9d2114", "source_id": "youtube-video-2025-01-03-master-frontend-development-in-2025-a-complete-roadmap-bfdva-7c1566cce2", "source_url": "https://www.youtube.com/watch?v=BfDVA_OsFLM", "title": "Participating in mock interviews", "topic": "Interview preparation", "topic_slug": "interview-preparation"}
{"author": "careerwithvasanth", "category": "youtube", "content": {"context_unit_ids": ["youtube-video-2025-01-03-master-frontend-development-in-2025-a-complete-roadmap-bfdva-7c1566cce2:u000022", "youtube-video-2025-01-03-master-frontend-development-in-2025-a-complete-roadmap-bfdva-7c1566cce2:u000023", "youtube-video-2025-01-03-master-frontend-development-in-2025-a-complete-roadmap-bfdva-7c1566cce2:u000024"], "cue": {"citations": [{"quote": "Because of which what happened I never understood the fundamentals concepts of JavaScript.", "unit_id": "youtube-video-2025-01-03-master-frontend-development-in-2025-a-complete-roadmap-bfdva-7c1566cce2:u000022"}], "text": "Vasanth realized he did not understand basic JavaScript concepts after a few years of work."}, "diagnosis": null, "kind": "reported_exchange", "outcome": null, "rationale": null, "response": {"citations": [{"quote": "Instead of building the things, I started understanding how things work behind the scenes step by step.", "unit_id": "youtube-video-2025-01-03-master-frontend-development-in-2025-a-complete-roadmap-bfdva-7c1566cce2:u000024"}], "text": "Vasanth started focusing on understanding how things work behind the scenes instead of just building products."}, "situation": {"citations": [{"quote": "like when this section I started like 2019 and 2020 where I realized I'm extremely hollow.", "unit_id": "youtube-video-2025-01-03-master-frontend-development-in-2025-a-complete-roadmap-bfdva-7c1566cce2:u000022"}], "text": "Vasanth reflects on his career where he realized the importance of understanding fundamental concepts of JavaScript late into his career."}, "speaker_id": null, "strategy": null, "title": "Realization of lacking JavaScript fundamentals", "topic": "Career reflection"}, "content_hash": "e344b73fd2438299416e511aea0e33438e76b5379be90b1d5138b5cd765259b1", "external_status": "not_checked", "extraction_scope": "source_excerpt", "id": "youtube-video-2025-01-03-master-frontend-development-in-2025-a-complete-roadmap-bfdva-7c1566cce2:cases:8569aa327423fb6a", "metadata_hash": "80de6a9fc71e04e70294db03ae496a0c4864721574ccf735d1fd93f4c265ca67", "product": "cases", "published_at": "2025-01-03", "semantic_status": "not_reviewed", "source_format": "transcript", "source_hash": "7eed79355bd51b176dbede9688b1d5f665aa031f69e7ed469a3b51f70d9d2114", "source_id": "youtube-video-2025-01-03-master-frontend-development-in-2025-a-complete-roadmap-bfdva-7c1566cce2", "source_url": "https://www.youtube.com/watch?v=BfDVA_OsFLM", "title": "Realization of lacking JavaScript fundamentals", "topic": "Career reflection", "topic_slug": "career-reflection"}
