{"author": null, "category": "youtube", "content": {"constraints": [], "context_unit_ids": ["youtube-video-2026-03-30-if-client-is-telling-you-i-m-hearing-alot-of-negative-new-ab-14701f23af:u000004", "youtube-video-2026-03-30-if-client-is-telling-you-i-m-hearing-alot-of-negative-new-ab-14701f23af:u000005"], "exceptions": [], "goal": {"citations": [{"quote": "reframe the general idea that he will bring to the table.", "unit_id": "youtube-video-2026-03-30-if-client-is-telling-you-i-m-hearing-alot-of-negative-new-ab-14701f23af:u000004"}], "text": "To help investors understand that the market has not stopped but shifted, encouraging them to make informed purchases."}, "kind": "advice", "prerequisites": [], "steps": [], "summary": {"citations": [{"quote": "you have to reframe the general idea that he will bring to the table. This idea is the market has stopped.", "unit_id": "youtube-video-2026-03-30-if-client-is-telling-you-i-m-hearing-alot-of-negative-new-ab-14701f23af:u000004"}, {"quote": "the market hasn't stopped.", "unit_id": "youtube-video-2026-03-30-if-client-is-telling-you-i-m-hearing-alot-of-negative-new-ab-14701f23af:u000005"}], "text": "Reframe the general idea an investor may have that the market has stopped. Highlight that the market has not stopped but has shifted, with buying driven by the selectiveness of buyers who know which projects and developers will sustain value."}, "title": "Reframing Market Perception", "topic": "investor_strategy"}, "content_hash": "d69d34f555cd5ed88068c60a94039bebef79a09cd87a0b66a1a691ee9a95d86f", "external_status": "not_checked", "extraction_scope": "source_excerpt", "id": "youtube-video-2026-03-30-if-client-is-telling-you-i-m-hearing-alot-of-negative-new-ab-14701f23af:knowledge:987726637886ff58", "metadata_hash": "ff58709b248048cbd4b3885e7ae79768270dbc0efd3b21029ab1129fa388e19f", "product": "knowledge", "published_at": "2026-03-30", "semantic_status": "not_reviewed", "source_format": "transcript", "source_hash": "c603a8355771