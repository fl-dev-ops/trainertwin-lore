rowth"}, "content_hash": "ed0fc70de20f2b27ec1bc3f36e4d572072931afbdf59c9f686b8ffed6e65ca13", "external_status": "not_checked", "extraction_scope": "source_excerpt", "id": "youtube-video-2026-04-04-dubai-real-estate-at-risk-what-s-actually-happening-right-no-d7838d914d:knowledge:1ac6223b1a075753", "metadata_hash": "85e676a4967e30b2c9af7294f17b45650a4e0f92a9ab060826e6a5e9bff4975e", "product": "knowledge", "published_at": "2026-04-04", "semantic_status": "not_reviewed", "source_format": "transcript", "source_hash": "5825bfdf47d97b1648a08a360ec60df00b3b90af6e4d64be76e4d898e4199320", "source_id": "youtube-video-2026-04-04-dubai-real-estate-at-risk-what-s-actually-happening-right-no-d7838d914d", "source_url": "https://www.youtube.com/watch?v=kyZfzU_cD3s", "title": "Unprecedented Growth of Developers", "topic": "developer_growth", "topic_slug": "developer_growth"}
