{"author": null, "category": "youtube", "content": {"constraints": [], "context_unit_ids": ["youtube-video-2026-04-04-dubai-real-estate-at-risk-what-s-actually-happening-right-no-d7838d914d:u000001", "youtube-video-2026-04-04-dubai-real-estate-at-risk-what-s-actually-happening-right-no-d7838d914d:u000002", "youtube-video-2026-04-04-dubai-real-estate-at-risk-what-s-actually-happening-right-no-d7838d914d:u000003", "youtube-video-2026-04-04-dubai-real-estate-at-risk-what-s-actually-happening-right-no-d7838d914d:u000004"], "exceptions": [], "goal": {"citations": [{"quote": "will help you regardless the market environment to keep selling", "unit_id": "youtube-video-2026-04-04-dubai-real-estate-at-risk-what-s-actually-happening-right-no-d7838d914d:u000002"}], "text": "To provide real estate agents with strategies to continue sales regardless of the market environment."}, "kind": "offering", "prerequisites": [], "steps": [], "summary": {"citations": [{"quote": "I'm not just doing videos like this but training agents how to make uncapped income in a commission only environment. This is a specific series where I walk you through nine different strategies", "unit_id": "youtube-video-2026-04-04-dubai-real-estate-at-risk-what-s-actually-happening-right-no-d7838d914d:u000001"}, {"quote": "will help you regardless the market environment to keep selling", "unit_id": "youtube-video-2026-04-04-dubai-real-estate-at-risk-what-s-actually-happening-right-no-d7838d914d:u000002"}], "text": "Olga Sinek offers training for agents on making uncapped income in a commission-only environment and presents nine strategies for continuing sales regardless of market environment."}, "title": "Strategies for Real Estate Agents", "topic": "real_estate_strategies"}, "content_hash": "ed0fc70de20f2b27ec1bc3f36e4d572072931afbdf59c9f686b8ffed6e65ca13", "external_status": "not_checked", "extraction_scope": "source_excerpt", "id": "youtube-video-2026-04-04-dubai-real-estate-at-risk-what-s-actually-happening-right-no-d7838d914d:knowledge:5d682168dae462ec", "metadata_hash": "85e676a4967e30b2c9af7294f17b45650a4e0f92a9ab060826e6a5e9bff4975e", "product": "knowledge", "published_at": "2026-04-04", "semantic_status": "not_reviewed", "source_format": "transcript", "source_hash": "5825bfdf47d97b1648a08a360ec60df00b3b90af6e4d64be76e4d898e4199320", "source_id": "youtube-video-2026-04-04-dubai-real-estate-at-risk-what-s-actually-happening-right-no-d7838d914d", "source_url": "https://www.youtube.com/watch?v=kyZfzU_cD3s", "title": "Strategies for Real Estate Agents", "topic": "real_estate_strategies", "topic_slug": "real_estate_strategies"}
{"author": null, "category": "youtube", "content": {"constraints": [], "context_unit_ids": ["youtube-video-2026-04-04-dubai-real-estate-at-risk-what-s-actually-happening-right-no-d7838d914d:u000005", "youtube-video-2026-04-04-dubai-real-estate-at-risk-what-s-actually-happening-right-no-d7838d914d:u000006", "youtube-video-2026-04-04-dubai-real-estate-at-risk-what-s-actually-happening-right-no-d7838d914d:u000007", "youtube-video-2026-04-04-dubai-real-estate-at-risk-what-s-actually-happening-right-no-d7838d914d:u000008", "youtube-video-2026-04-04-dubai-real-estate-at-risk-what-s-actually-happening-right-no-d7838d914d:u000009"], "exceptions": [], "goal": null, "kind": "claim", "prerequisites": [], "steps": [], "summary": {"citations": [{"quote": "Separate market risk from a specific developer risk. What does that mean? I have my notes here, hope you don't mind.", "unit_id": "youtube-video-2026-04-04-dubai-real-estate-at-risk-what-s-actually-happening-right-no-d7838d914d:u000005"}, {"quote": "not all risk, not all developers are made the same way.", "unit_id": "youtube-video-2026-04-04-dubai-real-estate-at-risk-what-s-actually-happening-right-no-d7838d914d:u000006"}, {"quote": "many small and new development were already at risk without a war.", "unit_id": "youtube-video-2026-04-04-dubai-real-estate-at-risk-what-s-actually-happening-right-no-d7838d914d:u000009"}], "text": "Not all developers are made the same way; small and new developments were already at risk without additional external factors."}, "title": "Risks in Real Estate Development", "topic": "developer_risks"}, "content_hash": "ed0fc70de20f2b27ec1bc3f36e4d572072931afbdf59c9f686b8ffed6e65ca13", "external_status": "not_checked", "extraction_scope": "source_excerpt", "id": "youtube-video-2026-04-04-dubai-real-estate-at-risk-what-s-actually-happening-right-no-d7838d914d:knowledge:1cfa226ba1e0e31a", "metadata_hash": "85e676a4967e30b2c9af7294f17b45650a4e0f92a9ab060826e6a5e9bff4975e", "product": "knowledge", "published_at": "2026-04-04", "semantic_status": "not_reviewed", "source_format": "transcript", "source_hash": "5825bfdf47d97b1648a08a360ec60df00b3b90af6e4d64be76e4d898e4199320", "source_id": "youtube-video-2026-04-04-dubai-real-estate-at-risk-what-s-actually-happening-right-no-d7838d914d", "source_url": "https://www.youtube.com/watch?v=kyZfzU_cD3s", "title": "Risks in Real Estate Development", "topic": "developer_risks", "topic_slug": "developer_risks"}
