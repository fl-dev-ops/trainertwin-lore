{"author": "olgasi", "category": "linkedin", "context": "advised", "date_basis": "source", "external_id": "7123594338042793984", "external_status": "not_checked", "id": "linkedin-posts-2023-10-27-what-is-the-main-reason-md-ed7d7f9fe5:c001:e002:e0428da7", "kind": "advice", "locator": "lines 9-22", "metadata_hash": "a478345eb6d03faa1591f993d411dc6a5f530db15706d72ec94d1112523f8401", "published_at": "2023-10-27T09:00:40.172000Z", "quote": "Finding those problems and needs with clients - is what distinguishes an average salesperson from a 1% TOP performer.", "source_hash": "e47c80c10133749e58495c2f95cb3baf1472759357312f51a2666730688bc80e", "source_id": "linkedin-posts-2023-10-27-what-is-the-main-reason-md-ed7d7f9fe5", "source_url": "https://www.linkedin.com/posts/olgasi_realestatesalestips-solvetheproblem-sellingrealestatedubai-activity-7123594338042793984-NYNW", "speaker_id": "", "statement": "Finding clients' problems and needs distinguishes average salespeople from top performers.", "time": "", "title": "What is the main reason to buy real estate?", "topic": "sales strategy", "topic_slug": "sales-strategy", "unit_id": "linkedin-posts-2023-10-27-what-is-the-main-reason-md-ed7d7f9fe5:u000001"}
{"author": "olgasi", "category": "linkedin", "context": "hypothetical", "date_basis": "source", "external_id": "7123594338042793984", "external_status": "not_checked", "id": "linkedin-posts-2023-10-27-what-is-the-main-reason-md-ed7d7f9fe5:c001:e003:84976e41", "kind": "belief", "locator": "lines 9-22", "metadata_hash": "a478345eb6d03faa1591f993d411dc6a5f530db15706d72ec94d1112523f8401", "published_at": "2023-10-27T09:00:40.172000Z", "quote": "Understanding the prospect’s problem is a mental shift for sales agents.", "source_hash": "e47c80c10133749e58495c2f95cb3baf1472759357312f51a2666730688bc80e", "source_id": "linkedin-posts-2023-10-27-what-is-the-main-reason-md-ed7d7f9fe5", "source_url": "https://www.linkedin.com/posts/olgasi_realestatesalestips-solvetheproblem-sellingrealestatedubai-activity-7123594338042793984-NYNW", "speaker_id": "", "statement": "Sales agents should understand the prospect’s problem to effectively sell real estate.", "time": "", "title": "What is the main reason to buy real estate?", "topic": "client engagement", "topic_slug": "client-engagement", "unit_id": "linkedin-posts-2023-10-27-what-is-the-main-reason-md-ed7d7f9fe5:u000001"}
{"author": "olgasi", "category": "linkedin", "context": "observed", "date_basis": "source", "external_id": "7123594338042793984", "external_status": "not_checked", "id": "linkedin-posts-2023-10-27-what-is-the-main-reason-md-ed7d7f9fe5:c001:e004:607edf66", "kind": "observed_behavior", "locator": "lines 23-27", "metadata_hash": "a478345eb6d03faa1591f993d411dc6a5f530db15706d72ec94d1112523f8401", "published_at": "2023-10-27T09:00:40.172000Z", "quote": "We discover together what his current situation is, and why he decided to change it in the first place.", "source_hash": "e47c80c10133749e58495c2f95cb3baf1472759357312f51a2666730688bc80e", "source_id": "linkedin-posts-2023-10-27-what-is-the-main-reason-md-ed7d7f9fe5", "source_url": "https://www.linkedin.com/posts/olgasi_realestatesalestips-solvetheproblem-sellingrealestatedubai-activity-7123594338042793984-NYNW", "speaker_id": "", "statement": "Communication with clients should focus on understanding their current situation and needs.", "time": "", "title": "What is the main reason to buy real estate?", "topic": "engagement strategy", "topic_slug": "engagement-strategy", "unit_id": "linkedin-posts-2023-10-27-what-is-the-main-reason-md-ed7d7f9fe5:u000002"}
{"author": "olgasi", "category": "linkedin", "context": "advised", "date_basis": "source", "external_id": "7123594338042793984", "external_status": "not_checked", "id": "linkedin-posts-2023-10-27-what-is-the-main-reason-md-ed7d7f9fe5:c001:e005:9ac14a9a", "kind": "advice", "locator": "lines 29-31", "metadata_hash": "a478345eb6d03faa1591f993d411dc6a5f530db15706d72ec94d1112523f8401", "published_at": "2023-10-27T09:00:40.172000Z", "quote": "Now you need to start building the internal urgency - his desire to change the situation as an opposite to the OVERUSED external urgency", "source_hash": "e47c80c10133749e58495c2f95cb3baf1472759357312f51a2666730688bc80e", "source_id": "linkedin-posts-2023-10-27-what-is-the-main-reason-md-ed7d7f9fe5", "source_url": "https://www.linkedin.com/posts/olgasi_realestatesalestips-solvetheproblem-sellingrealestatedubai-activity-7123594338042793984-NYNW", "speaker_id": "", "statement": "Build internal urgency based on clients' dissatisfaction with their current situation rather than using external urgency tactics.", "time": "", "title": "What is the main reason to buy real estate?", "topic": "building urgency", "topic_slug": "building-urgency", "unit_id": "linkedin-posts-2023-10-27-what-is-the-main-reason-md-ed7d7f9fe5:u000003"}
