{"author": "olgasi", "category": "youtube", "content": {"constraints": [], "context_unit_ids": ["youtube-video-2026-08-30-time-management-for-real-estate-agents-hour-by-hour-schedule-e4701583b6:u000027"], "exceptions": [], "goal": null, "kind": "claim", "prerequisites": [], "steps": [], "summary": {"citations": [{"quote": "discipline is not mood you find on Monday morning. It's a resource you either produce or borrow.", "unit_id": "youtube-video-2026-08-30-time-management-for-real-estate-agents-hour-by-hour-schedule-e4701583b6:u000027"}], "text": "Discipline is not a mood you find on Monday morning; it's a resource you either produce or borrow."}, "title": "Discipline in time management", "topic": "time management"}, "content_hash": "74e7ce9cb8a78b230b9b4be93c2d5e67f1242813167df0d59453d8d48fa8444d", "external_status": "not_checked", "extraction_scope": "source_excerpt", "id": "youtube-video-2026-08-30-time-management-for-real-estate-agents-hour-by-hour-schedule-e4701583b6:knowledge:87e8408668f8738a", "metadata_hash": "b2fb6de53d495fd78391bed971eafb60628a06c6aff8170a424d12c7d4b7ca0e", "product": "knowledge", "published_at": "2026-08-30", "semantic_status": "not_reviewed", "source_format": "transcript", "source_hash": "fc3c6d9995a89fdad098e239e283f8b9398564ffea17430a1b1ba8b08e580c51", "source_id": "youtube-video-2026-08-30-time-management-for-real-estate-agents-hour-by-hour-schedule-e4701583b6", "source_url": "https://www.youtube.com/watch?v=LT8S6d8aeYY", "title": "Discipline in time management", "topic": "time management", "topic_slug": "time-management"}
