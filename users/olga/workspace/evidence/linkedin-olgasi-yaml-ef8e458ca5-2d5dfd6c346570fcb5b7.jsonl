{"author": "olgasi", "category": "linkedin", "content": {"constraints": [], "context_unit_ids": ["linkedin-olgasi-yaml-ef8e458ca5:u000011"], "exceptions": [], "goal": null, "kind": "belief", "prerequisites": [], "steps": [], "summary": {"citations": [{"quote": "This is not about fake scripts, pressure or trying to convince people. It is about understanding human behavior, reading hesitation, knowing why clients delay decisions, asking the right questions and guiding them to a clear next step without pushing.", "unit_id": "linkedin-olgasi-yaml-ef8e458ca5:u000011"}], "text": "Influence in sales is not about fake scripts or trying to convince people, but understanding human behavior and guiding them to a clear next step."}, "title": "Influencing Clients", "topic": "sales training"}, "content_hash": "d1db38bf9a6e5c6fc1f017ef5085ab72a064f689823d31e6241767beef0c937b", "external_status": "not_checked", "extraction_scope": "source_excerpt", "id": "linkedin-olgasi-yaml-ef8e458ca5:knowledge:31f11690253a2bf0", "metadata_hash": "e74bcab385eaffc9384a724f72dd3f32001763dcc9e871d12a9bbdb45f39455b", "product": "knowledge", "published_at": null, "semantic_status": "not_reviewed", "source_format": "post", "source_hash": "359249d82b95169fab32d54914412c476733ae9c043d6dc5a66bd46d6a1e4082", "source_id": "linkedin-olgasi-yaml-ef8e458ca5", "source_url": null, "title": "Influencing Clients", "topic": "sales training", "topic_slug": "sales-training"}
{"author": "olgasi", "category": "linkedin", "content": {"constraints": [], "context_unit_ids": ["linkedin-olgasi-yaml-ef8e458ca5:u000011", "linkedin-olgasi-yaml-ef8e458ca5:u000012"], "exceptions": [], "goal": {"citations": [{"quote": "turn conversations, calls, presentations and follow-ups into closed deals.", "unit_id": "linkedin-olgasi-yaml-ef8e458ca5:u000011"}], "text": "To close deals in real estate sales."}, "kind": "method", "prerequisites": [], "steps": [], "summary": {"citations": [{"quote": "For the past 6+ years, I’ve been training Dubai real estate agents to turn conversations, calls, presentations and follow-ups into closed deals.", "unit_id": "linkedin-olgasi-yaml-ef8e458ca5:u000011"}], "text": "Real estate agents are trained to influence without fake scripts or pressure, and to understand human behavior to guide clients to the next step."}, "title": "Training methods for real estate agents", "topic": "sales training"}, "content_hash": "d1db38bf9a6e5c6fc1f017ef5085ab72a064f689823d31e6241767beef0c937b", "external_status": "not_checked", "extraction_scope": "source_excerpt", "id": "linkedin-olgasi-yaml-ef8e458ca5:knowledge:b4a9148110b6bfa6", "metadata_hash": "e74bcab385eaffc9384a724f72dd3f32001763dcc9e871d12a9bbdb45f39455b", "product": "knowledge", "published_at": null, "semantic_status": "not_reviewed", "source_format": "post", "source_hash": "359249d82b95169fab32d54914412c476733ae9c043d6dc5a66bd46d6a1e4082", "source_id": "linkedin-olgasi-yaml-ef8e458ca5", "source_url": null, "title": "Training methods for real estate agents", "topic": "sales training", "topic_slug": "sales-training"}
