{"author": "olgasi", "category": "linkedin", "content": {"constraints": [], "context_unit_ids": ["linkedin-olgasi-yaml-ef8e458ca5:u000101"], "exceptions": [], "goal": null, "kind": "belief", "prerequisites": [], "steps": [], "summary": {"citations": [{"quote": "The main thing I took away from this is that we shouldn't always be available, chasing after clients, and bombarding them with numerous options upon request. I liked the analogy with a doctor.", "unit_id": "linkedin-olgasi-yaml-ef8e458ca5:u000101"}], "text": "We shouldn't always be available, chasing clients, or bombarding them with numerous options upon request, similar to a doctor."}, "title": "Analogy with a Doctor", "topic": "sales_approach"}, "content_hash": "d1db38bf9a6e5c6fc1f017ef5085ab72a064f689823d31e6241767beef0c937b", "external_status": "not_checked", "extraction_scope": "source_excerpt", "id": "linkedin-olgasi-yaml-ef8e458ca5:knowledge:824647f371833ef6", "metadata_hash": "e74bcab385eaffc9384a724f72dd3f32001763dcc9e871d12a9bbdb45f39455b", "product": "knowledge", "published_at": null, "semantic_status": "not_reviewed", "source_format": "post", "source_hash": "359249d82b95169fab32d54914412c476733ae9c043d6dc5a66bd46d6a1e4082", "source_id": "linkedin-olgasi-yaml-ef8e458ca5", "source_url": null, "title": "Analogy with a Doctor", "topic": "sales_approach", "topic_slug": "sales_approach"}
