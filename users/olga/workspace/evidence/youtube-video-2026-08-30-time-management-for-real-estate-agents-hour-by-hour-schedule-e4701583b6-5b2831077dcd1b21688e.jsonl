{"author": null, "category": "youtube", "content": {"constraints": [], "context_unit_ids": ["youtube-video-2026-08-30-time-management-for-real-estate-agents-hour-by-hour-schedule-e4701583b6:u000026"], "exceptions": [], "goal": null, "kind": "claim", "prerequisites": [], "steps": [], "summary": {"citations": [{"quote": "you're not planning eight hours, you're protecting six, because this is how it ends for the ones who never do.", "unit_id": "youtube-video-2026-08-30-time-management-for-real-estate-agents-hour-by-hour-schedule-e4701583b6:u000026"}], "text": "Agents should protect six hours of their day because failing to plan properly leads to eventual failure in the market."}, "title": "Importance of protecting time", "topic": "time management"}, "content_hash": "74e7ce9cb8a78b230b9b4be93c2d5e67f1242813167df0d59453d8d48fa8444d", "external_status": "not_checked", "extraction_scope": "source_excerpt", "id": "youtube-video-2026-08-30-time-management-for-real-estate-agents-hour-by-hour-schedule-e4701583b6:knowledge:49ae508a5c1f22e6", "metadata_hash": "0095005081373111196ff1a1bf327770e7f4f9b6d324227680de219556550150", "product": "knowledge", "published_at": "2026-08-30", "semantic_status": "not_reviewed", "source_format": "transcript", "source_hash": "fc3c6d9995a89fdad098e239e283f8b9398564ffea17430a1b1ba8b08e580c51", "source_id": "youtube-video-2026-08-30-time-management-for-real-estate-agents-hour-by-hour-schedule-e4701583b6", "source_url": "https://www.youtube.com/watch?v=LT8S6d8aeYY", "title": "Importance of protecting time", "topic": "time management", "topic_slug": "time-management"}
{"author": null, "category": "youtube", "content": {"constraints": [], "context_unit_ids": ["youtube-video-2026-08-30-time-management-for-real-estate-agents-hour-by-hour-schedule-e4701583b6:u000027"], "exceptions": [], "goal": null, "kind": "advice", "prerequisites": [], "steps": [], "summary": {"citations": [{"quote": "Open your calendar and put the call blocks in. Two a day. Forty-five minutes each.", "unit_id": "youtube-video-2026-08-30-time-management-for-real-estate-agents-hour-by-hour-schedule-e4701583b6:u000027"}], "text": "Agents should open their calendar and schedule two call blocks a day, forty-five minutes each, to manage their time effectively."}, "title": "Scheduling call blocks", "topic": "time management"}, "content_hash": "74e7ce9cb8a78b230b9b4be93c2d5e67f1242813167df0d59453d8d48fa8444d", "external_status": "not_checked", "extraction_scope": "source_excerpt", "id": "youtube-video-2026-08-30-time-management-for-real-estate-agents-hour-by-hour-schedule-e4701583b6:knowledge:aaae4c5db72ac6cc", "metadata_hash": "0095005081373111196ff1a1bf327770e7f4f9b6d324227680de219556550150", "product": "knowledge", "published_at": "2026-08-30", "semantic_status": "not_reviewed", "source_format": "transcript", "source_hash": "fc3c6d9995a89fdad098e239e283f8b9398564ffea17430a1b1ba8b08e580c51", "source_id": "youtube-video-2026-08-30-time-management-for-real-estate-agents-hour-by-hour-schedule-e4701583b6", "source_url": "https://www.youtube.com/watch?v=LT8S6d8aeYY", "title": "Scheduling call blocks", "topic": "time management", "topic_slug": "time-management"}
{"author": null, "category": "youtube", "content": {"context_unit_ids": ["youtube-video-2026-08-30-time-management-for-real-estate-agents-hour-by-hour-schedule-e4701583b6:u000026", "youtube-video-2026-08-30-time-management-for-real-estate-agents-hour-by-hour-schedule-e4701583b6:u000027"], "cue": {"citations": [{"quote": "What do you do next?", "unit_id": "youtube-video-2026-08-30-time-management-for-real-estate-agents-hour-by-hour-schedule-e4701583b6:u000026"}], "text": "What do you do next?"}, "diagnosis": null, "kind": "reported_exchange", "outcome": null, "rationale": {"citations": [{"quote": "Because discipline is not mood you find on Monday morning. It's a resource you either produce or borrow.", "unit_id": "youtube-video-2026-08-30-time-management-for-real-estate-agents-hour-by-hour-schedule-e4701583b6:u000027"}], "text": "Discipline is not a mood to find on Monday morning but a resource you either produce or borrow."}, "response": null, "situation": {"citations": [{"quote": "impossible in this market... around month six with no deals, they're gone.", "unit_id": "youtube-video-2026-08-30-time-management-for-real-estate-agents-hour-by-hour-schedule-e4701583b6:u000026"}], "text": "Agents face unpredictability in their market which leads to inconsistent results and possible failure."}, "speaker_id": null, "strategy": {"citations": [{"quote": "Trap your talk minutes today.", "unit_id": "youtube-video-2026-08-30-time-management-for-real-estate-agents-hour-by-hour-schedule-e4701583b6:u000026"}, {"quote": "Open your calendar and put the call blocks in. Two a day. Forty-five minutes each.", "unit_id": "youtube-video-2026-08-30-time-management-for-real-estate-agents-hour-by-hour-schedule-e4701583b6:u000027"}], "text": "Trap your talk minutes today and schedule two forty-five minute call blocks a day."}, "title": "Time management strategy", "topic": "time management"}, "content_hash": "74e7ce9cb8a78b230b9b4be93c2d5e67f1242813167df0d59453d8d48fa8444d", "external_status": "not_checked", "extraction_scope": "source_excerpt", "id": "youtube-video-2026-08-30-time-management-for-real-estate-agents-hour-by-hour-schedule-e4701583b6:cases:c3df5b3f7b2ceb64", "metadata_hash": "0095005081373111196ff1a1bf327770e7f4f9b6d324227680de219556550150", "product": "cases", "published_at": "2026-08-30", "semantic_status": "not_reviewed", "source_format": "transcript", "source_hash": "fc3c6d9995a89fdad098e239e283f8b9398564ffea17430a1b1ba8b08e580c51", "source_id": "youtube-video-2026-08-30-time-management-for-real-estate-agents-hour-by-hour-schedule-e4701583b6", "source_url": "https://www.youtube.com/watch?v=LT8S6d8aeYY", "title": "Time management strategy", "topic": "time management", "topic_slug": "time-management"}
