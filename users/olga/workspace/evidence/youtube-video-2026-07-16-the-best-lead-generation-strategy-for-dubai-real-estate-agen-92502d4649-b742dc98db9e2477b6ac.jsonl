{"author": "olgasi", "category": "youtube", "content": {"constraints": [], "context_unit_ids": ["youtube-video-2026-07-16-the-best-lead-generation-strategy-for-dubai-real-estate-agen-92502d4649:u000026", "youtube-video-2026-07-16-the-best-lead-generation-strategy-for-dubai-real-estate-agen-92502d4649:u000027", "youtube-video-2026-07-16-the-best-lead-generation-strategy-for-dubai-real-estate-agen-92502d4649:u000028", "youtube-video-2026-07-16-the-best-lead-generation-strategy-for-dubai-real-estate-agen-92502d4649:u000029", "youtube-video-2026-07-16-the-best-lead-generation-strategy-for-dubai-real-estate-agen-92502d4649:u000030"], "exceptions": [{"citations": [{"quote": "this is how you get blocked, reported, or in some cases, you can put yourself at risk of financial penalties.", "unit_id": "youtube-video-2026-07-16-the-best-lead-generation-strategy-for-dubai-real-estate-agen-92502d4649:u000029"}], "text": "Using standard scripts can lead to being blocked, reported, or penalized."}], "goal": {"citations": [{"quote": "It's still the fastest way to create an opportunities in this market, but only if you know how to do that properly.", "unit_id": "youtube-video-2026-07-16-the-best-lead-generation-strategy-for-dubai-real-estate-agen-92502d4649:u000026"}], "text": "Create opportunities quickly through effective cold calling."}, "kind": "method", "prerequisites": [], "steps": [{"citations": [{"quote": "I created a specific technique which good for finding buyers and listings.", "unit_id": "youtube-video-2026-07-16-the-best-lead-generation-strategy-for-dubai-real-estate-agen-92502d4649:u000027"}], "text": "Develop specific techniques to find buyers and listings through cold calling."}, {"citations": [{"quote": "Coal calls when you ask, are you selling a rent in your property? Do not work.", "unit_id": "youtube-video-2026-07-16-the-best-lead-generation-strategy-for-dubai-real-estate-agen-92502d4649:u000029"}], "text": "Avoid standard scripts that ask directly if someone is selling or renting their property."}, {"citations": [{"quote": "if you make two hundred or three hundred dials a day", "unit_id": "youtube-video-2026-07-16-the-best-lead-generation-strategy-for-dubai-real-estate-agen-92502d4649:u000030"}], "text": "Make a large number of dials per day to maximize opportunities."}], "summary": {"citations": [{"quote": "Coal calls when you ask, are you selling a rent in your property? Do not work. Please do not do this.", "unit_id": "youtube-video-2026-07-16-the-best-lead-generation-strategy-for-dubai-real-estate-agen-92502d4649:u000029"}], "text": "Cold calling is a fast way to generate opportunities if done correctly, avoiding common scripting that can lead to penalties."}, "title": "Cold calling technique", "topic": "cold_calling"}, "content_hash": "32a29094d6e77b2abc52eb95d959dc96dcb7ca0ee5122719c60f882d90c156a4", "external_status": "not_checked", "extraction_scope": "source_excerpt", "id": "youtube-video-2026-07-16-the-best-lead-generation-strategy-for-dubai-real-estate-agen-92502d4649:knowledge:f7099a2fc7a30f58", "metadata_hash": "a7c27822d333fa36936d0b1ea4d8741a96bc143b3eb36d1b284bc5fefa6c93b6", "product": "knowledge", "published_at": "2026-07-16", "semantic_status": "not_reviewed", "source_format": "transcript", "source_hash": "d8b0b191c80a5c97a78216963929647af22f6d516c4ffa997882346dd5409425", "source_id": "youtube-video-2026-07-16-the-best-lead-generation-strategy-for-dubai-real-estate-agen-92502d4649", "source_url": "https://www.youtube.com/watch?v=x9mWjb117AA", "title": "Cold calling technique", "topic": "cold_calling", "topic_slug": "cold_calling"}
