{"author": "olgasi", "category": "linkedin", "context": "observed", "date_basis": "source", "external_id": "7092465657925033988", "external_status": "not_checked", "id": "linkedin-posts-2023-08-02-social-media-is-broadcasting-only-md-58fe074d5d:c001:e003:3a509d58", "kind": "fact_claim", "locator": "lines 9-17", "metadata_hash": "a215d43e4fdd6f9796b5f049661e8ff1dc44c11308b5285bd5b5b51e8a78e15b", "published_at": "2023-08-02T11:26:24.489000Z", "quote": "Red Zone - This may be everything related to your personal life, your family, spouse or your single life if that is so", "source_hash": "73975bf268758a0f874f12d61ac03999eb00230ea7fc74384a2234b23906bd62", "source_id": "linkedin-posts-2023-08-02-social-media-is-broadcasting-only-md-58fe074d5d", "source_url": "https://www.linkedin.com/posts/olgasi_highlightreels-onlythewins-socialmedialife-activity-7092465657925033988-gADs", "speaker_id": "", "statement": "The Red Zone includes personal life aspects that are shared on social media.", "time": "", "title": "Social media is broadcasting only the wins of real estate agents.", "topic": "social media engagement", "topic_slug": "social-media-engagement", "unit_id": "linkedin-posts-2023-08-02-social-media-is-broadcasting-only-md-58fe074d5d:u000001"}
{"author": "olgasi", "category": "linkedin", "context": "observed", "date_basis": "source", "external_id": "7092465657925033988", "external_status": "not_checked", "id": "linkedin-posts-2023-08-02-social-media-is-broadcasting-only-md-58fe074d5d:c001:e004:b55ce0e1", "kind": "fact_claim", "locator": "lines 9-17", "metadata_hash": "a215d43e4fdd6f9796b5f049661e8ff1dc44c11308b5285bd5b5b51e8a78e15b", "published_at": "2023-08-02T11:26:24.489000Z", "quote": "Yellow Zone - What are your fears when you are receiving ‘no’ from your clients, or when you are not wearing makeup or dressed to impress", "source_hash": "73975bf268758a0f874f12d61ac03999eb00230ea7fc74384a2234b23906bd62", "source_id": "linkedin-posts-2023-08-02-social-media-is-broadcasting-only-md-58fe074d5d", "source_url": "https://www.linkedin.com/posts/olgasi_highlightreels-onlythewins-socialmedialife-activity-7092465657925033988-gADs", "speaker_id": "", "statement": "The Yellow Zone relates to fears about showing vulnerability or failure to clients.", "time": "", "title": "Social media is broadcasting only the wins of real estate agents.", "topic": "social media engagement", "topic_slug": "social-media-engagement", "unit_id": "linkedin-posts-2023-08-02-social-media-is-broadcasting-only-md-58fe074d5d:u000001"}
