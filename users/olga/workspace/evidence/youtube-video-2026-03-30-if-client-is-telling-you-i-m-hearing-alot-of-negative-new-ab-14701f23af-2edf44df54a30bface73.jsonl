{"author": "olgasi", "category": "youtube", "content": {"constraints": [], "context_unit_ids": ["youtube-video-2026-03-30-if-client-is-telling-you-i-m-hearing-alot-of-negative-new-ab-14701f23af:u000001"], "exceptions": [], "goal": {"citations": [{"quote": "I decided to do short videos just like this where I will be showcasing nine different strategies for those agents who wants to keep selling offline.", "unit_id": "youtube-video-2026-03-30-if-client-is-telling-you-i-m-hearing-alot-of-negative-new-ab-14701f23af:u000001"}], "text": "To showcase nine different strategies for real estate agents who want to keep selling offline."}, "kind": "self_report", "prerequisites": [], "steps": [], "summary": {"citations": [{"quote": "My name is August and I'm real estate sales trainer and I decided to do short videos just like this where I will be showcasing nine different strategies for those agents who wants to keep selling offline.", "unit_id": "youtube-video-2026-03-30-if-client-is-telling-you-i-m-hearing-alot-of-negative-new-ab-14701f23af:u000001"}], "text": "The speaker decided to create short videos showcasing nine different strategies for real estate agents who want to keep selling offline."}, "title": "Showcasing Sales Strategies", "topic": "real_estate_sales"}, "content_hash": "d69d34f555cd5ed88068c60a94039bebef79a09cd87a0b66a1a691ee9a95d86f", "external_status": "not_checked", "extraction_scope": "source_excerpt", "id": "youtube-video-2026-03-30-if-client-is-telling-you-i-m-hearing-alot-of-negative-new-ab-14701f23af:knowledge:8e4fb0bb237a3810", "metadata_hash": "fa036ca4ddbb4a277fa81c730207350198d44b809bb47b67baf1faa087fc9976", "product": "knowledge", "published_at": "2026-03-30", "semantic_status": "not_reviewed", "source_format": "transcript", "source_hash": "c603a83557712279781397501c9297bc928e4b554cdfc217a8f6be9ea28726b7", "source_id": "youtube-video-2026-03-30-if-client-is-telling-you-i-m-hearing-alot-of-negative-new-ab-14701f23af", "source_url": "https://www.youtu