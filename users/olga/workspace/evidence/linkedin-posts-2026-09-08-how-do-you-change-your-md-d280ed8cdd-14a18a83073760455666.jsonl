{"author": "olgasi", "category": "linkedin", "content": {"constraints": [], "context_unit_ids": ["linkedin-posts-2026-09-08-how-do-you-change-your-md-d280ed8cdd:u000001"], "exceptions": [], "goal": null, "kind": "claim", "prerequisites": [], "steps": [], "summary": {"citations": [{"quote": "You do not experience life. You experience the life you focus on.", "unit_id": "linkedin-posts-2026-09-08-how-do-you-change-your-md-d280ed8cdd:u000001"}], "text": "You experience the life you focus on."}, "title": "Focus Determines Experience", "topic": "mindset"}, "content_hash": "deb1a32ddfd549e7a68d4c3f7e555209fb1885f805b186befa04225483c37e63", "external_status": "not_checked", "extraction_scope": "source_excerpt", "id": "linkedin-posts-2026-09-08-how-do-you-change-your-md-d280ed8cdd:knowledge:95b70935a5c635fe", "metadata_hash": "d2995724c995b89b1eace8131afe3d37a10d60deaa8be9972a5a149f53ba580e", "product": "knowledge", "published_at": "2026-09-08T06:00:10.742000Z", "semantic_status": "not_reviewed", "source_format": "post", "source_hash": "2f0334c49704659cd38a4d457d632e24ebe595b675c6a096073f8c09116c14ec", "source_id": "linkedin-posts-2026-09-08-how-do-you-change-your-md-d280ed8cdd", "source_url": "https://www.linkedin.com/posts/olgasi_how-do-you-change-your-income-your-life-activity-7502969011404689408-G_GB", "title": "Focus Determines Experience", "topic": "mindset", "topic_slug": "mindset"}
{"author": "olgasi", "category": "linkedin", "content": {"constraints": [], "context_unit_ids": ["linkedin-posts-2026-09-08-how-do-you-change-your-md-d280ed8cdd:u000001", "linkedin-posts-2026-09-08-how-do-you-change-your-md-d280ed8cdd:u000002"], "exceptions": [], "goal": null, "kind": "claim", "prerequisites": [], "steps": [], "summary": {"citations": [{"quote": "Its primary job is to protect you and help you survive.", "unit_id": "linkedin-posts-2026-09-08-how-do-you-change-your-md-d280ed8cdd:u000001"}, {"quote": "Your mind sees uncertainty and immediately creates the worst possible explanation to protect you...", "unit_id": "linkedin-posts-2026-09-08-how-do-you-change-your-md-d280ed8cdd:u000002"}], "text": "The mind's primary job is to protect you by identifying potential threats, and not necessarily to make you happy, successful, or confident."}, "title": "Mind's Protective Role", "topic": "mindset"}, "content_hash": "deb1a32ddfd549e7a68d4c3f7e555209fb1885f805b186befa04225483c37e63", "external_status": "not_checked", "extraction_scope": "source_excerpt", "id": "linkedin-posts-2026-09-08-how-do-you-change-your-md-d280ed8cdd:knowledge:229390d55d2977d8", "metadata_hash": "d2995724c995b89b1eace8131afe3d37a10d60deaa8be9972a5a149f53ba580e", "product": "knowledge", "published_at": "2026-09-08T06:00:10.742000Z", "semantic_status": "not_reviewed", "source_format": "post", "source_hash": "2f0334c49704659cd38a4d457d632e24ebe595b675c6a096073f8c09116c14ec", "source_id": "linkedin-posts-2026-09-08-how-do-you-change-your-md-d280ed8cdd", "source_url": "https://www.linkedin.com/posts/olgasi_how-do-you-change-your-income-your-life-activity-7502969011404689408-G_GB", "title": "Mind's Protective Role", "topic": "mindset", "topic_slug": "mindset"}
