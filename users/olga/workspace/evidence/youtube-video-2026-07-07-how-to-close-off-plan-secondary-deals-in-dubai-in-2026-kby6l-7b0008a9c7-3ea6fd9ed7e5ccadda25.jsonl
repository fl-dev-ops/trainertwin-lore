}
{"author": null, "category": "youtube", "content": {"constraints": [], "context_unit_ids": ["youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7:u000011", "youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7:u000012", "youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7:u000013", "youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7:u000014", "youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7:u000015", "youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7:u000016", "youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7:u000017", "youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7:u000018", "youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7:u000019", "youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7:u000020", "youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7:u000021", "youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7:u000022", "youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7:u000023"], "exceptions": [], "goal": {"citations": [{"quote": "what you should actually do to close an off plan", "unit_id": "youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7:u000011"}], "text": "To successfully close off-plan real estate deals."}, "kind": "method", "prerequisites": [{"citations": [{"quote": "you need to offer something that the client himself finds genuinely interesting", "unit_id": "youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7:u000013"}], "text": "Engaging clients with offers that are genuinely interesting."}], "steps": [{"citations": [{"quote": "To close off plan, you need at least two face-to-face conversations with the client.", "unit_id": "youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7:u000013"}], "text": "Engage clients through at least two face-to-face conversations, either in person or online."}, {"citations": [{"quote": "The key is you don't tell, because the right question creates vacuum in the client's mind.", "unit_id": "youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7:u000014"}], "text": "Use questions to create curiosity and a need for knowledge in the client."}, {"citations": [{"quote": "Would that make sense to book a time together on a Zoom so you can see with your own eyes.", "unit_id": "youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7:u000017"}], "text": "Ask if it makes sense to schedule a meeting on Zoom for better understanding."}], "summary": {"citations": [{"quote": "you need to offer something that the client himself finds genuinely interesting, not the same brochure...", "unit_id": "youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7:u000013"}], "text": "To close off-plan real estate deals, agents need to build interest and engage clients with interesting offers rather than just sending brochures."}, "title": "Strategies for Closing Off-Plan Deals", "topic": "Real Estate Strategies"}, "content_hash": "9ec8266772e29443038897050ed06db4bb56b39075d5a86796d6efe9eeec2781", "external_status": "not_checked", "extraction_scope": "source_excerpt", "id": "youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7:knowledge:1afcdb40554a16b3", "metadata_hash": "e4633568dac44682fba008e0d8c6eec15294ec40b9c7e1328a6c1af1cb55ce74", "product": "knowledge", "published_at": "2026-07-07", "semantic_status": "not_reviewed", "source_format": "transcript", "source_hash": "00dbd80c955b2284d8d4e29a5a60a37912cef7691bb6880cc169d160f761585a", "source_id": "youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7", "source_url": "https://www.youtube.com/watch?v=KBY6lwvcm9E", "title": "Strategies for Closing Off-Plan Deals", "topic": "Real Estate Strategies", "topic_slug": "real-estate-strategies"}
{"author": null, "category": "youtube", "content": {"constraints": [], "context_unit_ids": ["youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7:u000006", "youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7:u000007"], "exceptions": [], "goal": null, "kind": "belief", "prerequisites": [], "steps": [], "summary": {"citations": [{"quote": "the commission is paid by the seller, the person actually making money on the deal, not by the buyer, the way that works in Dubai.", "unit_id": "youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7:u000007"}], "text": "In Dubai, the real estate market is unique because commissions are typically paid by buyers, not sellers, unlike in markets like the US, Canada, or UK."}, "title": "Importance of Local Knowledge", "topic": "Market Differences"}, "content_hash": "9ec8266772e29443038897050ed06db4bb56b39075d5a86796d6efe9eeec2781", "external_status": "not_checked", "extraction_scope": "source_excerpt", "id": "youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7:knowledge:2db39e05dadd5782", "metadata_hash": "e4633568dac44682fba008e0d8c6eec15294ec40b9c7e1328a6c1af1cb55ce74", "product": "knowledge", "published_at": "2026-07-07", "semantic_status": "not_reviewed", "source_format": "transcript", "source_hash": "00dbd80c955b2284d8d4e29a5a60a37912cef7691bb6880cc169d160f761585a", "source_id": "youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7", "source_url": "https://www.youtube.com/watch?v=KBY6lwvcm9E", "title": "Importance of Local Knowledge", "topic": "Market Differences", "topic_slug": "market-differences"}
{"author": null, "category": "youtube", "content": {"constraints": [], "context_unit_ids": ["youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7:u000021", "youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7:u000022"], "exceptions": [], "goal": null, "kind": "claim", "prerequisites": [], "steps": [], "summary": {"citations": [{"quote": "The secondary market is a completely different animal and far more fragile one.", "unit_id": "youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7:u000021"}], "text": "The secondary real estate market in Dubai is particularly fragile due to various unpredictable factors that can destabilize a deal."}, "title": "Challenges in Secondary Real Estate Market", "topic": "Real Estate Strategies"}, "content_hash": "9ec8266772e29443038897050ed06db4bb56b39075d5a86796d6efe9eeec2781", "external_status": "not_checked", "extraction_scope": "source_excerpt", "id": "youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7:knowledge:3da95ec0da744600", "metadata_hash": "e4633568dac44682fba008e0d8c6eec15294ec40b9c7e1328a6c1af1cb55ce74", "product": "knowledge", "published_at": "2026-07-07", "semantic_status": "not_reviewed", "source_format": "transcript", "source_hash": "00dbd80c955b2284d8d4e29a5a60a37912cef7691bb6880cc169d160f761585a", "source_id": "youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7", "source_url": "https://www.youtube.com/watch?v=KBY6lwvcm9E", "title": "Challenges in Secondary Real Estate Market", "topic": "Real Estate Strategies", "topic_slug": "real-estate-strategies"}
{"author": null, "category": "youtube", "content": {"constraints": [], "context_unit_ids": ["youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7:u000029"], "exceptions": [], "goal": null, "kind": "advice", "prerequisites": [], "steps": [], "summary": {"citations": [{"quote": "You have to understand why this buyer is buying. Why now? Why this area? Why this type of property?", "unit_id": "youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7:u000029"}], "text": "As a buyer's agent, understanding the buyer's motivation, timing, and reason for purchase is crucial."}, "title": "Advice for Handling Buyers", "topic": "Real Estate Strategies"}, "content_hash": "9ec8266772e29443038897050ed06db4bb56b39075d5a86796d6efe9eeec2781", "external_status": "not_checked", "extraction_scope": "source_excerpt", "id": "youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7:knowledge:e61d715f41f27cb1", "metadata_hash": "e4633568dac44682fba008e0d8c6eec15294ec40b9c7e1328a6c1af1cb55ce74", "product": "knowledge", "published_at": "2026-07-07", "semantic_status": "not_reviewed", "source_format": "transcript", "source_hash": "00dbd80c955b2284d8d4e29a5a60a37912cef7691bb6880cc169d160f761585a", "source_id": "youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7", "source_url": "https://www.youtube.com/watch?v=KBY6lwvcm9E", "title": "Advice for Handling Buyers", "topic": "Real Estate Strategies", "topic_slug": "real-estate-strategies"}
{"author": null, "category": "youtube", "content": {"context_unit_ids": ["youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7:u000002"], "cue": {"citations": [{"quote": "The conversation starts well, the client shows interest, you prepare the options, send the brochure, payment plan, ROI calculations, answer the questions, and then the momentum disappears.", "unit_id": "youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7:u000002"}], "text": "Clients show interest initially but disappear after receiving information."}, "diagnosis": null, "kind": "reported_exchange", "outcome": null, "rationale": null, "response": null, "situation": {"citations": [{"quote": "Why do the clients disappear after I send them the information they asked for?... the client becomes less responsive.", "unit_id": "youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7:u000002"}], "text": "Real estate agents in Dubai report that after sending information to potential clients, follow-ups become harder, and clients become less responsive."}, "speaker_id": null, "strategy": null, "title": "Common Issue with Client Engagement", "topic": "Real Estate Strategies"}, "content_hash": "9ec8266772e29443038897050ed06db4bb56b39075d5a86796d6efe9eeec2781", "external_status": "not_checked", "extraction_scope": "source_excerpt", "id": "youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7:cases:ac6a4851ec22ae29", "metadata_hash": "e4633568dac44682fba008e0d8c6eec15294ec40b9c7e1328a6c1af1cb55ce74", "product": "cases", "published_at": "2026-07-07", "semantic_status": "not_reviewed", "source_format": "transcript", "source_hash": "00dbd80c955b2284d8d4e29a5a60a37912cef7691bb6880cc169d160f761585a", "source_id": "youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7", "source_url": "https://www.youtube.com/watch?v=KBY6lwvcm9E", "title": "Common Issue with Client Engagement", "topic": "Real Estate Strategies", "topic_slug": "real-estate-strategies"}
{"author": null, "category": "youtube", "content": {"context_unit_ids": ["youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7:u000006"], "cue": null, "diagnosis": null, "kind": "illustration", "outcome": null, "rationale": null, "response": null, "situation": {"citations": [{"quote": "Most of it back there comes from the portals where the owners list the property to sell themselves...That's your expired listings.", "unit_id": "youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7:u000006"}], "text": "Lead generation differs between Western markets and Dubai, where owners list their property themselves and expired listings open to agents who pay for access."}, "speaker_id": null, "strategy": null, "title": "Differences in Lead Generation", "topic": "Market Differences"}, "content_hash": "9ec8266772e29443038897050ed06db4bb56b39075d5a86796d6efe9eeec2781", "external_status": "not_checked", "extraction_scope": "source_excerpt", "id": "youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7:cases:33c4552a6844b7b0", "metadata_hash": "e4633568dac44682fba008e0d8c6eec15294ec40b9c7e1328a6c1af1cb55ce74", "product": "cases", "published_at": "2026-07-07", "semantic_status": "not_reviewed", "source_format": "transcript", "source_hash": "00dbd80c955b2284d8d4e29a5a60a37912cef7691bb6880cc169d160f761585a", "source_id": "youtube-video-2026-07-07-how-to-close-off-plan-secondary-deals-in-dubai-in-2026-kby6l-7b0008a9c7", "source_url": "https://www.youtube.com/watch?v=KBY6lwvcm9E", "title": "Differences in Lead Generation", "topic": "Market Differences", "topic_slug": "market-differences"}
