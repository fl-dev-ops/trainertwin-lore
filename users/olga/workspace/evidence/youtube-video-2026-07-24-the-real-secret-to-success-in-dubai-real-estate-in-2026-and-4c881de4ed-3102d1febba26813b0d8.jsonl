{"author": "olgasi", "category": "youtube", "content": {"context_unit_ids": ["youtube-video-2026-07-24-the-real-secret-to-success-in-dubai-real-estate-in-2026-and-4c881de4ed:u000005", "youtube-video-2026-07-24-the-real-secret-to-success-in-dubai-real-estate-in-2026-and-4c881de4ed:u000006"], "form": "rhetorical_move", "observation": {"citations": [{"quote": "knowledge without sales communication skill turns you into information provider, not a closer.", "unit_id": "youtube-video-2026-07-24-the-real-secret-to-success-in-dubai-real-estate-in-2026-and-4c881de4ed:u000006"}], "text": "The speaker contrasts confidence with merely having knowledge, emphasizing the need for communication skills to avoid becoming just an information provider."}, "purpose": null, "speaker_id": null, "title": "Contrasting Knowledge and Confidence", "topic": "confidence"}, "content_hash": "6ee5379ffdd75b81d227e5f584ac2fc8949b34114daf46cfe558954088ffe286", "external_status": "not_checked", "extraction_scope": "source_excerpt", "id": "youtube-video-2026-07-24-the-real-secret-to-success-in-dubai-real-estate-in-2026-and-4c881de4ed:expression:b90dddca16d3c528", "metadata_hash": "6922c4d6a46e952bc7443c9c00e7d5ed93b21129415ef25d06973d4f7968ee83", "product": "expression", "published_at": "2026-07-24", "semantic_status": "not_reviewed", "source_format": "transcript", "source_hash": "57900990414e92a459ab74e2af8b2ff3fe65929ab6ab76b26cbcd1b4fb978c27", "source_id": "youtube-video-2026-07-24-the-real-secret-to-success-in-dubai-real-estate-in-2026-and-4c881de4ed", "source_url": "https://www.youtube.com/watch?v=ctpRUnC9eg8", "title": "Contrasting Knowledge and Confidence", "topic": "confidence", "topic_slug": "confidence"}
