{"author": null, "category": "youtube", "content": {"constraints": [], "context_unit_ids": ["youtube-video-2026-04-12-if-your-client-says-dubai-is-oversupplied-answer-this-a3zi3t-f1e5ec1450:u000003", "youtube-video-2026-04-12-if-your-client-says-dubai-is-oversupplied-answer-this-a3zi3t-f1e5ec1450:u000004", "youtube-video-2026-04-12-if-your-client-says-dubai-is-oversupplied-answer-this-a3zi3t-f1e5ec1450:u000005", "youtube-video-2026-04-12-if-your-client-says-dubai-is-oversupplied-answer-this-a3zi3t-f1e5ec1450:u000006", "youtube-video-2026-04-12-if-your-client-says-dubai-is-oversupplied-answer-this-a3zi3t-f1e5ec1450:u000007", "youtube-video-2026-04-12-if-your-client-says-dubai-is-oversupplied-answer-this-a3zi3t-f1e5ec1450:u000008"], "exceptions": [], "goal": null, "kind": "method", "prerequisites": [], "steps": [{"citations": [{"quote": "The developer announced in one thing, which is supply on paper, but real delivery is completely different.", "unit_id": "youtube-video-2026-04-12-if-your-client-says-dubai-is-oversupplied-answer-this-a3zi3t-f1e5ec1450:u000007"}], "text": "The developer announces supply on paper, but real delivery is often different."}, {"citations": [{"quote": "If you will go to any platforms which at you as an agent should be using, hopefully you have an access from your company, reading, uh property monitor, you will see that there is a certain percentage of new units", "unit_id": "youtube-video-2026-04-12-if-your-client-says-dubai-is-oversupplied-answer-this-a3zi3t-f1e5ec1450:u000007"}, {"quote": "certain developers which are mentioned and then you go and understand what is the actual construction progress of this project", "unit_id": "youtube-video-2026-04-12-if-your-client-says-dubai-is-oversupplied-answer-this-a3zi3t-f1e5ec1450:u000008"}], "text": "Agents should use platforms like Property Monitor to check the actual construction progress of projects."}], "summary": {"citations": [{"quote": "You have to explain the difference between", "unit_id": "youtube-video-2026-04-12-if-your-client-says-dubai-is-oversupplied-answer-this-a3zi3t-f1e5ec1450:u000003"}, {"quote": "Supply on paper and real delivery supply.", "unit_id": "youtube-video-2026-04-12-if-your-client-says-dubai-is-oversupplied-answer-this-a3zi3t-f1e5ec1450:u000004"}], "text": "Explain the difference between supply on paper and real delivery supply to offline investors."}, "title": "Difference Between Paper Supply and Real Delivery", "topic": "real_estate_market"}, "content_hash": "cdf4361b0558fbc594e2c85305faf8e24a8759cfa4f28c644490df03b71f50f0", "external_status": "not_checked", "extraction_scope": "source_excerpt", "id": "youtube-video-2026-04-12-if-your-client-says-dubai-is-oversupplied-answer-this-a3zi3t-f1e5ec1450:knowledge:7070f7e5e4aaa16d", "metadata_hash": "b132e487a897078f79ac3b4b101af98e1a28277224c7e594b1dc35ef8a30d5db", "product": "knowledge", "published_at": "2026-04-12", "semantic_status": "not_reviewed", "source_format": "transcript", "source_hash": "c35664842cbdbc03b77be873fe4523036078f7da31d7275dbaf7bed6b5faa23c", "source_id": "youtube-video-2026-04-12-if-your-client-says-dubai-is-oversupplied-answer-this-a3zi3t-f1e5ec1450", "source_url": "https://www.youtube.com/watch?v=a3ZI3TpEaKc", "title": "Difference Between Paper Supply and Real Delivery", "topic": "real_estate_market", "topic_slug": "real_estate_market"}
{"author": null, "category": "youtube", "content": {"constraints": [], "context_unit_ids": ["youtube-video-2026-04-12-if-your-client-says-dubai-is-oversupplied-answer-this-a3zi3t-f1e5ec1450:u000009"], "exceptions": [], "goal": null, "kind": "claim", "prerequisites": [], "steps": [], "summary": {"citations": [{"quote": "The difference between on paper, which is announced and realistic, uh supply, which going to be handed over, is around forty percent.", "unit_id": "youtube-video-2026-04-12-if-your-client-says-dubai-is-oversupplied-answer-this-a3zi3t-f1e5ec1450:u000009"}], "text": "The difference between announced and actual supply is about 40% less."}, "title": "Fluctuation In Announced vs. Actual Supply", "topic": "real_estate_market"}, "content_hash": "cdf4361b0558fbc594e2c85305faf8e24a8759cfa4f28c644490df03b71f50f0", "external_status": "not_checked", "extraction_scope": "source_excerpt", "id": "youtube-video-2026-04-12-if-your-client-says-dubai-is-oversupplied-answer-this-a3zi3t-f1e5ec1450:knowledge:c6ed6af5bfbaf118", "metadata_hash": "b132e487a897078f79ac3b4b101af98e1a28277224c7e594b1dc35ef8a30d5db", "product": "knowledge", "published_at": "2026-04-12", "semantic_status": "not_reviewed", "source_format": "transcript", "source_hash": "c35664842cbdbc03b77be873fe4523036078f7da31d7275dbaf7bed6b5faa23c", "source_id": "youtube-video-2026-04-12-if-your-client-says-dubai-is-oversupplied-answer-this-a3zi3t-f1e5ec1450", "source_url": "https://www.youtube.com/watch?v=a3ZI3TpEaKc", "title": "Fluctuation In Announced vs. Actual Supply", "topic": "real_estate_market", "topic_slug": "real_estate_market"}
