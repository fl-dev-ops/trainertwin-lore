{"author": null, "category": "youtube", "content": {"constraints": [], "context_unit_ids": ["youtube-video-2026-05-07-why-most-distressed-deals-in-dubai-are-fake-05sbejv5zho-md-5ae767c007:u000017"], "exceptions": [], "goal": null, "kind": "advice", "prerequisites": [], "steps": [], "summary": {"citations": [{"quote": "If you are emotionally attached to one property, you will overpay. If you can walk away, you become a dangerous negotiation.", "unit_id": "youtube-video-2026-05-07-why-most-distressed-deals-in-dubai-are-fake-05sbejv5zho-md-5ae767c007:u000017"}], "text": "Avoid emotional attachment to a property to enhance negotiation leverage."}, "title": "Recommended negotiation strategy", "topic": "Dubai real estate strategy"}, "content_hash": "a4988032b692c8e807691ae15de3be8bd65734794879b4c3650c747f0b818902", "external_status": "not_checked", "extraction_scope": "source_excerpt", "id": "youtube-video-2026-05-07-why-most-distressed-deals-in-dubai-are-fake-05sbejv5zho-md-5ae767c007:knowledge:b9079933bdc603b3", "metadata_hash": "e0492e74824e430ceb5e15ff532827cb37b654f0e6a470a7bf9a3cdb27f556b7", "product": "knowledge", "published_at": "2026-05-07", "semantic_status": "not_reviewed", "source_format": "transcript", "source_hash": "75f0a1a8e0bc718c8f2fb968213468bec85dfb92a21d94fd2f59c7e309942cbe", "source_id": "youtube-video-2026-05-07-why-most-distressed-deals-in-dubai-are-fake-05sbejv5zho-md-5ae767c007", "source_url": "https://www.youtube.com/watch?v=05sBEJV5Zho", "title": "Recommended negotiation strategy", "topic": "Dubai real estate strategy", "topic_slug": "dubai-real-estate-strategy"}
